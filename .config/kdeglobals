# KDE/Qt shared settings for Doomslayer-mod
# ColorScheme: Doomshell (from theme.qml / kitty Bad Blood)
# Colors are also inlined so apps work even if the .colors file
# has not been installed to ~/.local/share/color-schemes yet.

[General]
ColorScheme=Doomshell
TerminalApplication=ghostty
TerminalService=com.mitchellh.ghostty.desktop

[KDE]
LookAndFeelPackage=org.kde.breeze.desktop
SingleClick=false
widgetStyle=Breeze
contrast=4

[Icons]
Theme=breeze-dark

[UiSettings]
ColorScheme=Doomshell

